<Project Sdk="Microsoft.NET.Sdk">
  <!-- Build: dotnet build -c Release (from this folder). Output goes straight to 1.6/Assemblies.
       RimWorld and Harmony are referenced via NuGet reference packages, so no local game install is needed. -->
  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>MechTab</AssemblyName>
    <RootNamespace>MechTab</RootNamespace>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <!-- Properties/AssemblyInfo.cs holds the assembly attributes -->
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <GenerateDependencyFile>false</GenerateDependencyFile>
    <OutputPath>..\..\1.6\Assemblies\</OutputPath>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Krafs.Rimworld.Ref" Version="1.6.4871" ExcludeAssets="runtime" />
    <PackageReference Include="Lib.Harmony.Ref" Version="2.3.6" ExcludeAssets="runtime" />
    <!-- Lets net472 build without the .NET Framework targeting pack (Linux/macOS, plain dotnet SDK) -->
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
